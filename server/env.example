# Express server
PORT=5000
CLIENT_URL=http://localhost:5173

# Option A: managed PostgreSQL (Neon, Supabase, Render, Railway...)
# Paste the provider's connection string. When set, the DB_* vars below are ignored.
# DATABASE_URL=postgresql://user:password@host/food_delivery_db?sslmode=require
# Set to true only if the URL has no sslmode parameter but the provider requires TLS.
# DB_SSL=true

# Option B: local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_delivery_db
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_postgres_password
